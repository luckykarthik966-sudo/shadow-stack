# Server
PORT=8080
HOST=0.0.0.0
CORS_ORIGIN=http://localhost:5173

# Set this for durable hosting. If omitted, the server uses an in-memory store.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/wise_money
PG_POOL_MAX=10

# Optional: set a long random secret when exposing admin routes publicly.
HOST_ADMIN_TOKEN=replace-me
